#!/usr/bin/env bash
set -euo pipefail

secret_files=(
  "{{ openbao_vector_opensearch_username_file }}"
  "{{ openbao_vector_opensearch_password_file }}"
)

for secret_file in "${secret_files[@]}"; do
  if [[ ! -s "${secret_file}" ]]; then
    echo "${secret_file} is missing or empty" >&2
    exit 1
  fi

  chmod 0640 "${secret_file}"

  if getent group "{{ openbao_vector_service_group }}" >/dev/null 2>&1; then
    chgrp "{{ openbao_vector_service_group }}" "${secret_file}"
  fi
done

if systemctl list-unit-files "{{ openbao_vector_service_name }}.service" >/dev/null 2>&1 \
  && systemctl is-active --quiet "{{ openbao_vector_service_name }}.service"; then
  systemctl try-restart "{{ openbao_vector_service_name }}.service"
fi
