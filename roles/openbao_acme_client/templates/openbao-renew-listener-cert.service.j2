[Unit]
Description=Renew OpenBao listener certificate via OpenBao ACME
After=network-online.target openbao.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/openbao-acme-renew
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths={{ openbao_tls_dir }} {{ openbao_acme_config_dir }} /var/lib/openbao
