#!/usr/bin/env bash
set -euo pipefail

umask 077

{% if openbao_acme_challenge == 'dns-01' %}
if [[ -f "{{ openbao_acme_dns_env_file }}" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "{{ openbao_acme_dns_env_file }}"
  set +a
fi
{% endif %}

set -a
# shellcheck disable=SC1091
source "{{ openbao_acme_eab_env_file }}"
set +a

export LEGO_CA_CERTIFICATES="{{ openbao_ca_cert_file }}"

LEGO_PATH="/var/lib/openbao/lego"
PRIMARY_DOMAIN="{{ openbao_public_fqdn }}"
CERT_FILE="{{ openbao_acme_certificate_path }}"
KEY_FILE="{{ openbao_acme_key_path }}"
WORK_CERT="$(mktemp)"
WORK_KEY="$(mktemp)"

cleanup() {
  rm -f "${WORK_CERT}" "${WORK_KEY}"
}
trap cleanup EXIT

args=(
  --path "${LEGO_PATH}"
  --server "${OPENBAO_ACME_DIRECTORY}"
  --email "${OPENBAO_ACME_EMAIL}"
  --accept-tos
  --eab
  --kid "${OPENBAO_ACME_EAB_KEY_ID}"
  --hmac "${OPENBAO_ACME_EAB_HMAC_KEY}"
{% if openbao_acme_challenge == 'dns-01' %}
  --dns "{{ openbao_acme_dns_provider }}"
{% elif openbao_acme_challenge == 'http-01' %}
  --http
{% elif openbao_acme_challenge == 'tls-alpn-01' %}
  --tls
{% endif %}
{% for domain in openbao_acme_certificate_domains %}
  --domains "{{ domain }}"
{% endfor %}
{% for extra_arg in openbao_acme_extra_args %}
  "{{ extra_arg }}"
{% endfor %}
)

if [[ -f "${CERT_FILE}" ]]; then
  lego "${args[@]}" renew --days 30 --reuse-key
else
  lego "${args[@]}" run
fi

lego_cert="${LEGO_PATH}/certificates/${PRIMARY_DOMAIN}.crt"
lego_issuer="${LEGO_PATH}/certificates/${PRIMARY_DOMAIN}.issuer.crt"
lego_key="${LEGO_PATH}/certificates/${PRIMARY_DOMAIN}.key"

if [[ ! -s "${lego_cert}" || ! -s "${lego_key}" ]]; then
  echo "lego did not produce expected certificate files for ${PRIMARY_DOMAIN}" >&2
  exit 1
fi

cat "${lego_cert}" > "${WORK_CERT}"
if [[ -s "${lego_issuer}" ]]; then
  cat "${lego_issuer}" >> "${WORK_CERT}"
fi
cp "${lego_key}" "${WORK_KEY}"

install -o "{{ openbao_service_user }}" -g "{{ openbao_service_group }}" -m 0640 "${WORK_CERT}" "${CERT_FILE}"
install -o "{{ openbao_service_user }}" -g "{{ openbao_service_group }}" -m 0600 "${WORK_KEY}" "${KEY_FILE}"

systemctl kill -s HUP openbao || systemctl restart openbao
