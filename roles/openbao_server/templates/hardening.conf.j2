[Service]
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ ([openbao_config_dir, openbao_data_dir, openbao_log_dir] + ([openbao_native_acme_cache_path] if openbao_certificate_mode == 'native_acme' else [])) | join(' ') }}
StateDirectory=openbao
LogsDirectory=openbao
RuntimeDirectory=openbao
MemorySwapMax=0
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
