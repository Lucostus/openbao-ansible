---
# Encrypt the real file with:
#   ansible-vault encrypt group_vars/rhel10/vault.yml

# Optional legacy static seal input. Bootstrap now defaults to generating one
# ignored controller artifact per environment. To keep supplying this value from
# Vault, set openbao_static_seal_source=variable.
# openbao_static_unseal_key_b64: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# Production best practice is an offline root CA. These values are required
# only when enabling OpenBao Agent or native listener ACME renewal with the
# variable-based PKI signing source.
openbao_root_ca_cert_pem: |
  -----BEGIN CERTIFICATE-----
  REPLACE_WITH_ROOT_CA_CERTIFICATE
  -----END CERTIFICATE-----

openbao_root_ca_key_pem: |
  -----BEGIN PRIVATE KEY-----
  REPLACE_WITH_ROOT_CA_PRIVATE_KEY
  -----END PRIVATE KEY-----
